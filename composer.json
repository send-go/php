{
    "name": "techigh/sendgo",
    "description": "Sendgo PHP SDK — 카카오 알림톡/친구톡, SMS/LMS/MMS",
    "license": "MIT",
    "keywords": ["sendgo", "kakao", "alimtalk", "friendtalk", "sms", "notification", "korea"],
    "homepage": "https://sendgo.io",
    "authors": [{"name": "Techigh", "email": "techigh@amuz.co.kr"}],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Techigh\\Sendgo\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Techigh\\Sendgo\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Techigh\\Sendgo\\Laravel\\SendgoServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {"sort-packages": true}
}
