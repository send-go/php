{
    "name": "sendgo/php",
    "description": "Sendgo PHP SDK — 카카오 알림톡/친구톡, SMS/LMS/MMS 발송",
    "license": "MIT",
    "keywords": ["sendgo", "kakao", "alimtalk", "friendtalk", "sms", "notification", "korea"],
    "homepage": "https://sendgo.io",
    "authors": [{"name": "Sendgo", "email": "dev@sendgo.io"}],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Sendgo\\Php\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Sendgo\\Php\\Tests\\": "tests/"}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {"sort-packages": true}
}
